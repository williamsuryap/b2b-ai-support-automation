# =============================================================================
# B2B AI Support & Workflow Automation System - Environment Configuration
# =============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=support_automation
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_automation

# LLM Provider Configuration
# Set OPENAI_API_KEY to your actual key, or leave as 'mock' for local simulation testing
OPENAI_API_KEY=mock
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
CONFIDENCE_THRESHOLD=0.8

# Backend Service Configuration
BACKEND_PORT=8000
ENVIRONMENT=development

# n8n Orchestrator Configuration
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/

# Streamlit Impact Dashboard
DASHBOARD_PORT=8501
